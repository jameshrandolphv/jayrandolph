{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/icons/**",
          "/wallpaper.jpg",
          "/fonts/**",
          "/engine/**"
        ]
      }
    },
    {
      "name": "on-demand",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/*.wasm", "/film/**"]
      }
    }
  ]
}
